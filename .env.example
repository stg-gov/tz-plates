# Copy to .env and adjust. Never commit real secrets.

TZ_ALPR_ENV=development
TZ_ALPR_LOG_LEVEL=INFO

# Model registry paths (relative to repo root or absolute)
TZ_ALPR_OCR_WEIGHTS=models/ocr/v1/ocr_crnn.pt
TZ_ALPR_OCR_ONNX=models/ocr/v1/ocr_crnn.onnx
TZ_ALPR_PLATE_DETECTOR_WEIGHTS=models/plate_detector/v1/plate_yolo.pt
# Leave unset to use COCO-pretrained yolov8n for vehicle detection (Phase 2 default).
# Set only after fine-tuning for minibus/tuk-tuk (training/train_vehicle_detector.py):
# TZ_ALPR_VEHICLE_DETECTOR_WEIGHTS=models/detector/v1/vehicle_yolo.pt

# Inference config
TZ_ALPR_MODEL_VERSION=tz-alpr-1.2.0
TZ_ALPR_DEVICE=cpu
TZ_ALPR_ENABLE_SUPER_RESOLUTION=false

# API
TZ_ALPR_API_HOST=0.0.0.0
TZ_ALPR_API_PORT=8080
TZ_ALPR_MAX_UPLOAD_MB=25

# Webhooks (Phase 4 — unused in Phase 1)
TZ_ALPR_WEBHOOK_SECRET=change-me

# Postgres / Redis (Phase 4)
POSTGRES_USER=alpr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alpr
REDIS_URL=redis://redis:6379/0
