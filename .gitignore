__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Data & artifacts
# Original sources, generated crops, labels and training splits never belong in Git.
labeled_images/
labels.jsonl
labeled_images.zip
datasets/raw/
datasets/processed/
datasets/synthetic/
datasets/ocr/*
datasets/splits/*
datasets/retraining_queue/*
datasets/annotations/accepted_labels.jsonl
datasets/annotations/metadata.jsonl
datasets/annotations/ocr/*
datasets/annotations/plates/*
datasets/annotations/vehicles/*
!datasets/**/.gitkeep

# Model weights
*.pt
*.pth
*.onnx
*.engine
checkpoints/
models/**/*.pt
models/**/*.onnx
# ...but keep the small (~5 MB) open-source pretrained plate detector in-repo so
# training boxes without internet can still bootstrap. Re-fetch: tools/fetch_pretrained.py
!models/plate_detector/v1/plate_yolo.pt
lightning_logs/
wandb/
runs/
logs/
reports/
