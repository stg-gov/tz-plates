__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Data & artifacts
# Original sources, generated crops, labels and training splits never belong in Git.
labeled_images/
labels.jsonl
labeled_images.zip
datasets/raw/
datasets/processed/
datasets/synthetic/
datasets/ocr/*
datasets/splits/*
datasets/retraining_queue/*
datasets/annotations/accepted_labels.jsonl
datasets/annotations/metadata.jsonl
datasets/annotations/ocr/*
datasets/annotations/plates/*
datasets/annotations/vehicles/*
datasets/.last_train_manifest
hf_export/
!datasets/**/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Model weights and training artifacts
*.pt
*.pth
*.onnx
*.engine
*.ckpt
yolov8*.pt
yolo11*.pt
checkpoints/
models/**/*.pt
models/**/*.onnx
models/ocr/v1/*
!models/ocr/v1/.gitkeep
# Keep the small (~5 MB) open-source pretrained plate detector so
# training boxes without internet can still bootstrap.
# Re-fetch: python tools/fetch_pretrained.py
!models/plate_detector/v1/plate_yolo.pt
lightning_logs/
wandb/
runs/
logs/
reports/
